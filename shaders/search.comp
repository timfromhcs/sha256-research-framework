#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer HeaderBuffer {
    uint header_words[16]; // Fixed prefix block
};

layout(std430, binding = 1) buffer ResultBuffer {
    uint found_flag;      // 0 = searching, 1 = found
    uint winning_nonce_lo;// lower 32 bits of nonce
    uint winning_nonce_hi;// upper 32 bits of nonce
    uint winning_hash[8]; // 8 words of the resulting hash
};

layout(push_constant) uniform PushConstants {
    uint nonce_base_lo;
    uint nonce_base_hi;
    uint target_zero_bits;
    uint iterations_per_thread;
} pc;

const uint K[64] = uint[64](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr(uint x, uint n) { return (x >> n) | (x << (32u - n)); }
uint ch(uint x, uint y, uint z) { return (x & y) ^ (~x & z); }
uint maj(uint x, uint y, uint z) { return (x & y) ^ (x & z) ^ (y & z); }
uint sigma0(uint x) { return rotr(x, 2u) ^ rotr(x, 13u) ^ rotr(x, 22u); }
uint sigma1(uint x) { return rotr(x, 6u) ^ rotr(x, 11u) ^ rotr(x, 25u); }
uint gamma0(uint x) { return rotr(x, 7u) ^ rotr(x, 18u) ^ (x >> 3u); }
uint gamma1(uint x) { return rotr(x, 17u) ^ rotr(x, 19u) ^ (x >> 10u); }

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint thread_offset = gid * pc.iterations_per_thread;

    for (uint iter = 0u; iter < pc.iterations_per_thread; ++iter) {
        if (found_flag != 0u) return; // Early exit if already found

        uint cur_nonce_lo = pc.nonce_base_lo + thread_offset + iter;
        uint cur_nonce_hi = pc.nonce_base_hi;

        uint W[64];
        for (uint i = 0u; i < 16u; ++i) {
            W[i] = header_words[i];
        }
        // Nonce is embedded into words 3 and 4
        W[3] = cur_nonce_hi;
        W[4] = cur_nonce_lo;

        for (uint i = 16u; i < 64u; ++i) {
            W[i] = gamma1(W[i - 2u]) + W[i - 7u] + gamma0(W[i - 15u]) + W[i - 16u];
        }

        uint a = 0x6a09e667u;
        uint b = 0xbb67ae85u;
        uint c = 0x3c6ef372u;
        uint d = 0xa54ff53au;
        uint e = 0x510e527fu;
        uint f = 0x9b05688cu;
        uint g = 0x1f83d9abu;
        uint h = 0x5be0cd19u;

        for (uint t = 0u; t < 64u; ++t) {
            uint t1 = h + sigma1(e) + ch(e, f, g) + K[t] + W[t];
            uint t2 = sigma0(a) + maj(a, b, c);
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }

        a += 0x6a09e667u;
        b += 0xbb67ae85u;
        c += 0x3c6ef372u;
        d += 0xa54ff53au;
        e += 0x510e527fu;
        f += 0x9b05688cu;
        g += 0x1f83d9abu;
        h += 0x5be0cd19u;

        // Check if top target_zero_bits of word 'a' are zero
        uint mask = (pc.target_zero_bits == 0u) ? 0u :
                    (pc.target_zero_bits >= 32u) ? 0xFFFFFFFFu :
                    ~((1u << (32u - pc.target_zero_bits)) - 1u);
        if ((a & mask) == 0u) {
            if (atomicExchange(found_flag, 1u) == 0u) {
                winning_nonce_lo = cur_nonce_lo;
                winning_nonce_hi = cur_nonce_hi;
                winning_hash[0] = a;
                winning_hash[1] = b;
                winning_hash[2] = c;
                winning_hash[3] = d;
                winning_hash[4] = e;
                winning_hash[5] = f;
                winning_hash[6] = g;
                winning_hash[7] = h;
            }
            return;
        }
    }
}
