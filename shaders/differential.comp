#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BaseMessageBuffer {
    uint base_words[]; // Base messages (16 words each)
};

layout(std430, binding = 1) readonly buffer DeltaBuffer {
    uint delta_words[]; // Difference delta (16 words each)
};

layout(std430, binding = 2) writeonly buffer ResultBuffer {
    // Output: matching bit count or difference word array (8 words per pair)
    uint diff_output[];
};

layout(push_constant) uniform PushConstants {
    uint total_pairs;
    uint num_rounds;
} pc;

const uint K[64] = uint[64](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr(uint x, uint n) { return (x >> n) | (x << (32u - n)); }
uint ch(uint x, uint y, uint z) { return (x & y) ^ (~x & z); }
uint maj(uint x, uint y, uint z) { return (x & y) ^ (x & z) ^ (y & z); }
uint sigma0(uint x) { return rotr(x, 2u) ^ rotr(x, 13u) ^ rotr(x, 22u); }
uint sigma1(uint x) { return rotr(x, 6u) ^ rotr(x, 11u) ^ rotr(x, 25u); }
uint gamma0(uint x) { return rotr(x, 7u) ^ rotr(x, 18u) ^ (x >> 3u); }
uint gamma1(uint x) { return rotr(x, 17u) ^ rotr(x, 19u) ^ (x >> 10u); }

void compress_sim(in uint W[64], uint rounds, out uint out_state[8]) {
    uint a = 0x6a09e667u;
    uint b = 0xbb67ae85u;
    uint c = 0x3c6ef372u;
    uint d = 0xa54ff53au;
    uint e = 0x510e527fu;
    uint f = 0x9b05688cu;
    uint g = 0x1f83d9abu;
    uint h = 0x5be0cd19u;

    for (uint t = 0u; t < rounds; ++t) {
        uint t1 = h + sigma1(e) + ch(e, f, g) + K[t] + W[t];
        uint t2 = sigma0(a) + maj(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    out_state[0] = a + 0x6a09e667u;
    out_state[1] = b + 0xbb67ae85u;
    out_state[2] = c + 0x3c6ef372u;
    out_state[3] = d + 0xa54ff53au;
    out_state[4] = e + 0x510e527fu;
    out_state[5] = f + 0x9b05688cu;
    out_state[6] = g + 0x1f83d9abu;
    out_state[7] = h + 0x5be0cd19u;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.total_pairs) return;

    uint base_idx = gid * 16u;
    uint W1[64], W2[64];

    for (uint i = 0u; i < 16u; ++i) {
        uint m1 = base_words[base_idx + i];
        uint d = delta_words[i]; // Shared or individual delta
        W1[i] = m1;
        W2[i] = m1 ^ d;
    }

    for (uint i = 16u; i < 64u; ++i) {
        W1[i] = gamma1(W1[i - 2u]) + W1[i - 7u] + gamma0(W1[i - 15u]) + W1[i - 16u];
        W2[i] = gamma1(W2[i - 2u]) + W2[i - 7u] + gamma0(W2[i - 15u]) + W2[i - 16u];
    }

    uint rounds = min(pc.num_rounds, 64u);
    uint S1[8], S2[8];
    compress_sim(W1, rounds, S1);
    compress_sim(W2, rounds, S2);

    // Compute difference ΔH = S1 ⊕ S2
    uint out_idx = gid * 8u;
    for (uint j = 0u; j < 8u; ++j) {
        diff_output[out_idx + j] = S1[j] ^ S2[j];
    }
}
